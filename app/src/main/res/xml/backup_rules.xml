<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and older (android:fullBackupContent).
  Everything the app stores locally is excluded: the Room database (cached questions and the survey
  draft), the DataStore settings, shared preferences (Firebase Auth keeps its session and token cache
  there, and Firebase installation ids) and app files. Nothing in them is worth restoring: the account
  and its data live in Firebase, the questions are downloaded again, and a restored session or
  installation id on another device would be a credential copied out of the app sandbox.
  The mirror for Android 12+ is data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
