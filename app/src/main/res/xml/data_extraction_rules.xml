<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12+ (android:dataExtractionRules).
  Same policy as backup_rules.xml: nothing local leaves the device, neither to the cloud backup nor
  to a new device. That covers the Room database, the DataStore settings, shared preferences (the
  Firebase Auth session and token cache, installation ids) and app files. The user signs in again
  and the data comes back from Firebase.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
