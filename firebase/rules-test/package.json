{
  "name": "youknow-rules-test",
  "private": true,
  "type": "module",
  "description": "Security rules tests for Firestore, Realtime Database and Storage, run against the emulators.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,database,storage --project demo-youknow --config ../../firebase.emulators.json \"node --test --test-concurrency=1\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.36.0"
  }
}
