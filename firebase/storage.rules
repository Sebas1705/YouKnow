rules_version = '2';

// YouKnow — Cloud Storage. Everything requires a signed-in user; a file's owner is read from the
// path itself (profile_photos/{uid}), not from a document field, so no lookup is needed. Anything
// not matched below is denied.
service firebase.storage {
  match /b/{bucket}/o {

    // profile_photos/{uid}: one file per user, overwritten on every re-upload. Everyone signed in
    // reads them (shown in the ranking, groups, chat); only the owner writes or deletes theirs,
    // and only an image under 5 MB.
    match /profile_photos/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
